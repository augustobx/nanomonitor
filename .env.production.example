# ==============================================================================
# NanoLabs Control Center - Production Environment Configuration
# File: /opt/apps/nanomonitor/.env
# ==============================================================================

# Database Credentials
DB_USER=nanomonitor_user
DB_PASSWORD=CHANGE_ME_GENERATE_SECURE_POSTGRES_PASSWORD
DB_NAME=nanomonitor_prod

# Redis Credentials
REDIS_PASSWORD=CHANGE_ME_GENERATE_SECURE_REDIS_PASSWORD

# Security Secrets (Generate using openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_JWT_SECRET_AT_LEAST_32_CHARS
ADMIN_INITIAL_PASSWORD=CHANGE_ME_ADMIN_INITIAL_PASSWORD
