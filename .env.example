# NanoLabs Control Center — Environment Variables
# Copy this file to .env and fill in the values

# === Database ===
POSTGRES_USER=nanocontrol
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=nanocontrol
DATABASE_URL=postgresql://nanocontrol:changeme_strong_password@db:5432/nanocontrol

# === Redis ===
REDIS_URL=redis://redis:6379

# === API Server ===
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=production

# === Auth ===
JWT_SECRET=changeme_generate_with_openssl_rand_base64_64
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# === Agent Auth ===
AGENT_AUTH_CLOCK_SKEW_SECONDS=300
AGENT_AUTH_NONCE_TTL_SECONDS=600

# === Rate Limiting ===
RATE_LIMIT_AGENT_HEARTBEAT=60
RATE_LIMIT_AGENT_METRICS=30
RATE_LIMIT_AGENT_INVENTORY=10
RATE_LIMIT_WEB_GENERAL=100

# === Web Frontend ===
NEXT_PUBLIC_API_URL=https://control-api.nanoapps.site
WEB_PORT=3001

# === Enrollment ===
ENROLLMENT_TOKEN_EXPIRY_HOURS=24
ENROLLMENT_TOKEN_LENGTH=32

# === Telemetry Retention (days) ===
RETENTION_RAW_DAYS=7
RETENTION_HOURLY_DAYS=90
RETENTION_DAILY_DAYS=365

# === Logging ===
LOG_LEVEL=info

# === Backups ===
BACKUP_DIR=/opt/backups/nanocontrol
BACKUP_RETENTION_DAYS=30
