# NanoLabs Control Center Server Environment Configuration

# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://nanouser:nanopass2026@localhost:5432/nanomonitor?schema=public

# Redis (Telemetry cache, Nonces, Rate-limits)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=nanoredis2026

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-for-dev-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Agent Security
AGENT_TIMESTAMP_DRIFT_SECS=300
